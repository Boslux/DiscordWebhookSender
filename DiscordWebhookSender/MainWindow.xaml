<Window x:Class="DiscordWebhookSender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discord Automation" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        Background="#1E1E1E" Foreground="White" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3F3F3F"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#5865F2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid Margin="25">
        <StackPanel Width="400">
            <TextBlock Text="Social Automation" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,25" HorizontalAlignment="Center"/>

            <!-- Source Config -->
            <GroupBox Header="Settings" Foreground="White" BorderBrush="#3F3F3F" Margin="0,0,0,15" Padding="15">
                <StackPanel>
                    <Label Content="Website RSS/Link"/>
                    <TextBox x:Name="LinkBox"/>
                    
                    <Label Content="Custom Message (Optional)"/>
                    <TextBox x:Name="MessageInputBox"/>
                    
                    <CheckBox x:Name="IncludeDescriptionBox" IsChecked="True" Content="Include RSS Description (from Site)"/>
                </StackPanel>
            </GroupBox>

            <!-- Platforms -->
            <GroupBox Header="Destination" Foreground="White" BorderBrush="#3F3F3F" Margin="0,0,0,15" Padding="15">
                <StackPanel>
                    <Label Content="Discord Webhook URL"/>
                    <TextBox x:Name="WebhookUrlBox"/>
                    
                    <CheckBox x:Name="SaveSettingsBox" Content="Save API &amp; RSS Link (Local Only)" Foreground="#AAAAAA" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <Button x:Name="SendButton" Content="Send Now" Height="45" Margin="0,5,0,0" Click="SendButton_Click"/>
            
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="Gray" Margin="0,15,0,5" HorizontalAlignment="Center" FontSize="11"/>
        </StackPanel>
    </Grid>
</Window>
